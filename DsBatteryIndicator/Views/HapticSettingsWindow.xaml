<Window x:Class="DsBatteryIndicator.Views.HapticSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DsBatteryIndicator.Views"
        Title="震动 / 灯带设置" MinWidth="340"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1A1A24" Foreground="#D0D0D8">
    <Window.Resources>
        <!-- 细线 Slider 模板 -->
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16">
                            <!-- 背景轨道 -->
                            <Border Height="3" Background="#2A2A3E" CornerRadius="2"
                                    VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <!-- 已填充轨道 -->
                            <Border Name="TrackFill" Height="3" Background="#60A5FA"
                                    CornerRadius="2" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" Margin="0,0,0,0"/>
                            <!-- 拇指 -->
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#60A5FA"
                                                         Stroke="#1A1A24" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数字输入框样式 -->
        <Style x:Key="NumInput" TargetType="TextBox">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="#D0D0D8"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
        </Style>

        <!-- 开关式 CheckBox 样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <!-- 开关轨道 -->
                            <Border Name="SwitchTrack" Width="40" Height="22"
                                    CornerRadius="11" Background="#3A3A45"
                                    BorderBrush="#4A4A55" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <!-- 开关滑块 -->
                                <Border Name="SwitchThumb" Width="16" Height="16"
                                        CornerRadius="8" Background="#808088"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#1E3A5F"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#60A5FA"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#5A5A65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <views:RgbConverter x:Key="RgbConverter"/>
    </Window.Resources>

    <StackPanel Margin="20,16">
        <!-- 标题 -->
        <TextBlock Text="震动 / 灯带设置" FontSize="15" FontWeight="SemiBold"
                   Foreground="#E0E0E8" Margin="0,0,0,12"/>

        <!-- 震动强度 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="震动强度" VerticalAlignment="Center" FontSize="12"/>
            <Slider x:Name="SliderIntensity" Grid.Column="1" Style="{StaticResource SlimSlider}"
                    Minimum="50" Maximum="255" Value="255" Margin="6,0,8,0"/>
            <TextBox x:Name="TxtIntensity" Grid.Column="2" Style="{StaticResource NumInput}"
                     VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Grid>

        <!-- 震动时间 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="震动时间" VerticalAlignment="Center" FontSize="12"/>
            <Slider x:Name="SliderHapticTime" Grid.Column="1" Style="{StaticResource SlimSlider}"
                    Minimum="100" Maximum="3000" Value="800" Margin="6,0,8,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBox x:Name="TxtHapticTime" Style="{StaticResource NumInput}"/>
                <TextBlock Text="ms" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 灯带时间 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="灯带时间" VerticalAlignment="Center" FontSize="12"/>
            <Slider x:Name="SliderLightTime" Grid.Column="1" Style="{StaticResource SlimSlider}"
                    Minimum="500" Maximum="10000" Value="3000" Margin="6,0,8,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBox x:Name="TxtLightTime" Style="{StaticResource NumInput}"/>
                <TextBlock Text="ms" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 分隔线 -->
        <Border Height="1" Background="#2A2A35" Margin="0,4,0,8"/>

        <!-- 灯带颜色 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="灯带颜色" VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="R" Foreground="#FF6666" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox x:Name="TxtR" Style="{StaticResource NumInput}" Width="42"/>
                <TextBlock Text="G" Foreground="#66FF66" FontSize="10" VerticalAlignment="Center" Margin="10,0,2,0"/>
                <TextBox x:Name="TxtG" Style="{StaticResource NumInput}" Width="42"/>
                <TextBlock Text="B" Foreground="#6666FF" FontSize="10" VerticalAlignment="Center" Margin="10,0,2,0"/>
                <TextBox x:Name="TxtB" Style="{StaticResource NumInput}" Width="42"/>
                <Border Width="30" Height="30" CornerRadius="6" BorderBrush="#3A3A45"
                        BorderThickness="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border.Background>
                        <SolidColorBrush>
                            <SolidColorBrush.Color>
                                <MultiBinding Converter="{StaticResource RgbConverter}">
                                    <Binding ElementName="TxtR" Path="Text" FallbackValue="255"/>
                                    <Binding ElementName="TxtG" Path="Text" FallbackValue="0"/>
                                    <Binding ElementName="TxtB" Path="Text" FallbackValue="0"/>
                                </MultiBinding>
                            </SolidColorBrush.Color>
                        </SolidColorBrush>
                    </Border.Background>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 分隔线 -->
        <Border Height="1" Background="#2A2A35" Margin="0,8,0,6"/>

        <!-- 电量不足提示 -->
        <TextBlock Text="电量不足提示" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E8" Margin="0,0,0,6"/>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="68"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="启用提示" VerticalAlignment="Center" FontSize="12"/>
            <CheckBox x:Name="ChkAlertEnabled" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="68"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="电量阈值" VerticalAlignment="Center" FontSize="12"/>
            <Slider x:Name="SliderThreshold" Grid.Column="1" Style="{StaticResource SlimSlider}"
                    Minimum="10" Maximum="90" Value="10" Margin="4,0,8,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBox x:Name="TxtThreshold" Style="{StaticResource NumInput}" Width="40"/>
                <TextBlock Text="%" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="68"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="重复提醒" VerticalAlignment="Center" FontSize="12"/>
            <CheckBox x:Name="ChkRepeatEnabled" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="68"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="提醒间隔" VerticalAlignment="Center" FontSize="12"/>
            <Slider x:Name="SliderRepeatInterval" Grid.Column="1" Style="{StaticResource SlimSlider}"
                    Minimum="15" Maximum="300" Value="60" Margin="4,0,8,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBox x:Name="TxtRepeatInterval" Style="{StaticResource NumInput}" Width="40"/>
                <TextBlock Text="s" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnTest" Content="测试" Width="76" Height="30" Margin="0,0,8,0"
                    Foreground="#D0D0D8" FontSize="12" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" Background="#2A2A3E" CornerRadius="6"
                                BorderBrush="#3A3A45" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35354A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnSave" Content="保存" Width="76" Height="30"
                    Foreground="White" FontSize="12" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" Background="#3A5A9A" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A6DB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
