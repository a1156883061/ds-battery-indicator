<Window x:Class="DsBatteryIndicator.Views.HapticSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DsBatteryIndicator.Views"
        Title="" MinWidth="320"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1A1A24" Foreground="#D0D0D8">
    <Window.Resources>
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16">
                            <Border Height="3" Background="#2A2A3E" CornerRadius="2" VerticalAlignment="Center"/>
                            <Border Name="TrackFill" Height="3" Background="#60A5FA" CornerRadius="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#60A5FA"
                                                         Stroke="#1A1A24" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumInput" TargetType="TextBox">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="#D0D0D8"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border Name="SwitchTrack" Width="40" Height="22" CornerRadius="11"
                                    Background="#3A3A45" BorderBrush="#4A4A55" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border Name="SwitchThumb" Width="16" Height="16" CornerRadius="8"
                                        Background="#808088" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#1E3A5F"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#60A5FA"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <views:RgbConverter x:Key="RgbConverter"/>
    </Window.Resources>

    <StackPanel Margin="20,16">
        <TextBlock x:Name="LblTitle" FontSize="15" FontWeight="SemiBold"
                   Foreground="#E0E0E8" Margin="0,0,0,14"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="56"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- 低电量通知 -->
                <RowDefinition Height="Auto"/>     <!-- 0: 标题 -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>     <!-- 2: 总开关行 -->
                <RowDefinition Height="Auto"/>     <!-- 3: 子开关面板 -->
                <RowDefinition Height="Auto"/>     <!-- 4: 电量阈值 -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>     <!-- 6: 重复提醒 -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>     <!-- 8: 提醒间隔 -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>     <!-- 10: 分隔线 -->
                <RowDefinition Height="12"/>
                <!-- 震动/灯带 -->
                <RowDefinition Height="Auto"/>     <!-- 12: 震动强度 -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>     <!-- 14: 震动时间 -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>     <!-- 16: 灯带时间 -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>     <!-- 18: 分隔线 -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>     <!-- 20: 灯带颜色 -->
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>     <!-- 22: 分隔线 -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>     <!-- 24: 窗口透明度 -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>     <!-- 26: 分隔线 -->
                <RowDefinition Height="10"/>
                <!-- 音频提醒 -->
                <RowDefinition Height="Auto"/>     <!-- 28: 标题 -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>     <!-- 30: 扬声器音量 -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>     <!-- 32: 蜂鸣时长 -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>     <!-- 34: 自定义音频 -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>     <!-- 36: 分隔线 -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>     <!-- 38: 轮询时间 -->
            </Grid.RowDefinitions>

            <!-- 0: 低电量通知（标题） -->
            <TextBlock x:Name="LblLowBatterySection" Grid.Row="0" Grid.ColumnSpan="5"
                       FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E8"/>

            <!-- 2: 总开关行 -->
            <Border Grid.Row="2" Grid.ColumnSpan="5" Margin="0,0,0,2"
                    Background="#1F1F2C" CornerRadius="6" BorderBrush="#2A2A35" BorderThickness="1">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LblAlertEnabled" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E8" Margin="0,0,10,0"/>
                        <CheckBox x:Name="ChkAlertEnabled" VerticalAlignment="Center"
                                  Checked="MasterSwitch_Changed" Unchecked="MasterSwitch_Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCollapseArrow" Grid.Column="2" Text="▼"
                               FontSize="10" Foreground="#60A5FA" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="CollapseArrow_Click"/>
                </Grid>
            </Border>

            <!-- 3: 子开关面板 -->
            <Border x:Name="SubSwitchPanel" Grid.Row="3" Grid.ColumnSpan="5" Margin="0,4,0,6"
                    Background="#14141D" CornerRadius="6" BorderBrush="#252535" BorderThickness="1"
                    Padding="10,12">
                <Grid>
                    <!-- 子开关内容 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Grid.Column="0">
                            <CheckBox x:Name="ChkHaptic" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblHapticSwitch" VerticalAlignment="Center" FontSize="11"/>
                        </DockPanel>
                        <DockPanel Grid.Row="0" Grid.Column="2">
                            <CheckBox x:Name="ChkLightbar" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblLightbarSwitch" VerticalAlignment="Center" FontSize="11"/>
                        </DockPanel>
                        <DockPanel Grid.Row="2" Grid.Column="0">
                            <CheckBox x:Name="ChkControllerSpeaker" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblControllerSpeaker" VerticalAlignment="Center" FontSize="11"/>
                        </DockPanel>
                        <DockPanel Grid.Row="2" Grid.Column="2">
                            <CheckBox x:Name="ChkBalloonTip" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblBalloonTipSwitch" VerticalAlignment="Center" FontSize="11"/>
                        </DockPanel>
                        <DockPanel Grid.Row="4" Grid.Column="0">
                            <CheckBox x:Name="ChkAlertSound" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblAlertSoundSwitch" VerticalAlignment="Center" FontSize="11"/>
                        </DockPanel>
                    </Grid>

                    <!-- 蒙版遮罩 -->
                    <Border x:Name="SubSwitchMask" Background="#CC000000" CornerRadius="6"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="提醒已全部禁用" Foreground="#808088" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 4: 电量阈值 -->
            <TextBlock x:Name="LblAlertThreshold" Grid.Row="4" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <Slider x:Name="SliderThreshold" Grid.Row="4" Grid.Column="2"
                    Style="{StaticResource SlimSlider}" Minimum="10" Maximum="90" Value="10"/>
            <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtThreshold" Style="{StaticResource NumInput}"/>
                <TextBlock Text="%" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- 6: 重复提醒 -->
            <TextBlock x:Name="LblRepeatEnabled" Grid.Row="6" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <CheckBox x:Name="ChkRepeatEnabled" Grid.Row="6" Grid.Column="4" VerticalAlignment="Center"/>

            <!-- 8: 提醒间隔 -->
            <TextBlock x:Name="LblRepeatInterval" Grid.Row="8" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Row="8" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnInterval300" Content="5min" Tag="300" Width="46" Height="22"
                        FontSize="11" Margin="0,0,4,0" Cursor="Hand" Click="PresetInterval_Click"/>
                <Button x:Name="BtnInterval600" Content="10min" Tag="600" Width="46" Height="22"
                        FontSize="11" Margin="0,0,4,0" Cursor="Hand" Click="PresetInterval_Click"/>
                <Button x:Name="BtnInterval1800" Content="30min" Tag="1800" Width="46" Height="22"
                        FontSize="11" Margin="0,0,4,0" Cursor="Hand" Click="PresetInterval_Click"/>
                <Button x:Name="BtnInterval3600" Content="1h" Tag="3600" Width="46" Height="22"
                        FontSize="11" Margin="0,0,8,0" Cursor="Hand" Click="PresetInterval_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="8" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtRepeatInterval" Style="{StaticResource NumInput}"/>
                <TextBlock Text="s" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- 10: 分隔线 -->
            <Border Grid.Row="10" Grid.ColumnSpan="5" Height="1" Background="#2A2A35"/>

            <!-- 12: 震动强度 -->
            <TextBlock x:Name="LblHapticIntensity" Grid.Row="12" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <Slider x:Name="SliderIntensity" Grid.Row="12" Grid.Column="2"
                    Style="{StaticResource SlimSlider}" Minimum="50" Maximum="255" Value="255"/>
            <TextBox x:Name="TxtIntensity" Grid.Row="12" Grid.Column="4" HorizontalAlignment="Left" Style="{StaticResource NumInput}"/>

            <!-- 14: 震动时间 -->
            <TextBlock x:Name="LblHapticDuration" Grid.Row="14" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Row="14" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnHaptic200" Content="200ms" Tag="200" Width="46" Height="22" FontSize="11"
                        Margin="0,0,4,0" Cursor="Hand" Click="PresetHapticTime_Click"/>
                <Button x:Name="BtnHaptic500" Content="500ms" Tag="500" Width="46" Height="22" FontSize="11"
                        Margin="0,0,4,0" Cursor="Hand" Click="PresetHapticTime_Click"/>
                <Button x:Name="BtnHaptic800" Content="800ms" Tag="800" Width="46" Height="22" FontSize="11"
                        Margin="0,0,4,0" Cursor="Hand" Click="PresetHapticTime_Click"/>
                <Button x:Name="BtnHaptic1000" Content="1s" Tag="1000" Width="46" Height="22" FontSize="11"
                        Margin="0,0,8,0" Cursor="Hand" Click="PresetHapticTime_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="14" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtHapticTime" Style="{StaticResource NumInput}"/>
                <TextBlock Text="ms" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- 16: 灯带时间 -->
            <TextBlock x:Name="LblLightbarDuration" Grid.Row="16" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Row="16" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnLight1000" Content="1s" Tag="1000" Width="46" Height="22" FontSize="11"
                        Margin="0,0,4,0" Cursor="Hand" Click="PresetLightTime_Click"/>
                <Button x:Name="BtnLight3000" Content="3s" Tag="3000" Width="46" Height="22" FontSize="11"
                        Margin="0,0,4,0" Cursor="Hand" Click="PresetLightTime_Click"/>
                <Button x:Name="BtnLight5000" Content="5s" Tag="5000" Width="46" Height="22" FontSize="11"
                        Margin="0,0,4,0" Cursor="Hand" Click="PresetLightTime_Click"/>
                <Button x:Name="BtnLight10000" Content="10s" Tag="10000" Width="46" Height="22" FontSize="11"
                        Margin="0,0,8,0" Cursor="Hand" Click="PresetLightTime_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="16" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtLightTime" Style="{StaticResource NumInput}"/>
                <TextBlock Text="ms" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- 18: 分隔线 -->
            <Border Grid.Row="18" Grid.ColumnSpan="5" Height="1" Background="#2A2A35"/>

            <!-- 20: 灯带颜色 -->
            <TextBlock x:Name="LblLightbarColor" Grid.Row="20" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Row="20" Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="R" Foreground="#FF6666" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox x:Name="TxtR" Style="{StaticResource NumInput}"/>
                <TextBlock Text="G" Foreground="#66FF66" FontSize="10" VerticalAlignment="Center" Margin="10,0,2,0"/>
                <TextBox x:Name="TxtG" Style="{StaticResource NumInput}"/>
                <TextBlock Text="B" Foreground="#6666FF" FontSize="10" VerticalAlignment="Center" Margin="10,0,2,0"/>
                <TextBox x:Name="TxtB" Style="{StaticResource NumInput}"/>
                <Border Width="30" Height="30" CornerRadius="6" BorderBrush="#3A3A45" BorderThickness="1"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border.Background>
                        <SolidColorBrush>
                            <SolidColorBrush.Color>
                                <MultiBinding Converter="{StaticResource RgbConverter}">
                                    <Binding ElementName="TxtR" Path="Text" FallbackValue="255"/>
                                    <Binding ElementName="TxtG" Path="Text" FallbackValue="0"/>
                                    <Binding ElementName="TxtB" Path="Text" FallbackValue="0"/>
                                </MultiBinding>
                            </SolidColorBrush.Color>
                        </SolidColorBrush>
                    </Border.Background>
                </Border>
            </StackPanel>

            <!-- 22: 分隔线 -->
            <Border Grid.Row="22" Grid.ColumnSpan="5" Height="1" Background="#2A2A35"/>

            <!-- 24: 窗口透明度 -->
            <TextBlock x:Name="LblOpacity" Grid.Row="24" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <Slider x:Name="SliderOpacity" Grid.Row="24" Grid.Column="2"
                    Style="{StaticResource SlimSlider}" Minimum="30" Maximum="100" Value="100"/>
            <StackPanel Grid.Row="24" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtOpacity" Style="{StaticResource NumInput}"/>
                <TextBlock Text="%" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- 26: 分隔线 -->
            <Border Grid.Row="26" Grid.ColumnSpan="5" Height="1" Background="#2A2A35"/>

            <!-- 28: 音频提醒配置（标题） -->
            <TextBlock x:Name="LblAudioAlertSection" Grid.Row="28" Grid.ColumnSpan="5"
                       FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E8"/>

            <!-- 30: 扬声器音量 -->
            <TextBlock x:Name="LblSpeakerVolume" Grid.Row="30" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <Slider x:Name="SliderSpeakerVolume" Grid.Row="30" Grid.Column="2"
                    Style="{StaticResource SlimSlider}" Minimum="10" Maximum="100" Value="80"/>
            <StackPanel Grid.Row="30" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtSpeakerVolume" Style="{StaticResource NumInput}"/>
                <TextBlock Text="%" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- 32: 蜂鸣时长 -->
            <TextBlock x:Name="LblSpeakerDuration" Grid.Row="32" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Row="32" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnSpk200" Content="200ms" Tag="200" Width="46" Height="22" FontSize="11"
                        Margin="0,0,4,0" Cursor="Hand" Click="PresetSpeakerTime_Click"/>
                <Button x:Name="BtnSpk500" Content="500ms" Tag="500" Width="46" Height="22" FontSize="11"
                        Margin="0,0,4,0" Cursor="Hand" Click="PresetSpeakerTime_Click"/>
                <Button x:Name="BtnSpk800" Content="800ms" Tag="800" Width="46" Height="22" FontSize="11"
                        Margin="0,0,4,0" Cursor="Hand" Click="PresetSpeakerTime_Click"/>
                <Button x:Name="BtnSpk1000" Content="1s" Tag="1000" Width="46" Height="22" FontSize="11"
                        Margin="0,0,8,0" Cursor="Hand" Click="PresetSpeakerTime_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="32" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtSpeakerDuration" Style="{StaticResource NumInput}"/>
                <TextBlock Text="ms" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- 34: 自定义音频文件 -->
            <TextBlock x:Name="LblCustomAudio" Grid.Row="34" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Row="34" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TxtAudioPath" FontSize="11" Foreground="#808088"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="180"/>
                <Button x:Name="BtnClearAudio" Content="✕" Width="20" Height="20" FontSize="10"
                        Margin="4,0,0,0" Cursor="Hand" Click="BtnClearAudio_Click"
                        Visibility="Collapsed"
                        Background="Transparent" Foreground="#808088" BorderThickness="0"/>
                <Button x:Name="BtnSelectAudio" Width="68" Height="24" FontSize="11"
                        Margin="8,0,0,0" Cursor="Hand" Click="BtnSelectAudio_Click"/>
            </StackPanel>

            <!-- 36: 分隔线 -->
            <Border Grid.Row="36" Grid.ColumnSpan="5" Height="1" Background="#2A2A35"/>

            <!-- 38: 轮询时间 -->
            <TextBlock x:Name="LblPollingInterval" Grid.Row="38" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Row="38" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnPoll50" Content="50ms" Tag="50" Width="46" Height="22"
                        FontSize="11" Margin="0,0,4,0" Cursor="Hand" Click="PresetPolling_Click"/>
                <Button x:Name="BtnPoll250" Content="250ms" Tag="250" Width="46" Height="22"
                        FontSize="11" Margin="0,0,4,0" Cursor="Hand" Click="PresetPolling_Click"/>
                <Button x:Name="BtnPoll1000" Content="1s" Tag="1000" Width="46" Height="22"
                        FontSize="11" Margin="0,0,4,0" Cursor="Hand" Click="PresetPolling_Click"/>
                <Button x:Name="BtnPoll10000" Content="10s" Tag="10000" Width="46" Height="22"
                        FontSize="11" Margin="0,0,8,0" Cursor="Hand" Click="PresetPolling_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="38" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtPollingInterval" Style="{StaticResource NumInput}"/>
                <TextBlock Text="ms" FontSize="10" Foreground="#808088" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnTest" Content="测试" Width="76" Height="30" Margin="0,0,8,0"
                    Foreground="#D0D0D8" FontSize="12" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" Background="#2A2A3E" CornerRadius="6"
                                BorderBrush="#3A3A45" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35354A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnSave" Content="保存" Width="76" Height="30"
                    Foreground="White" FontSize="12" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" Background="#3A5A9A" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A6DB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
