<Window x:Class="DsBatteryIndicator.Views.HapticSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="震动/灯带设置" Width="380" Height="420"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1E1E24" Foreground="#D8D8DD">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 震动时间 -->
        <TextBlock Grid.Row="0" Text="震动时间 (ms)" Margin="0,8,0,2"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="SliderHapticTime" Minimum="100" Maximum="3000"
                    Value="800" TickFrequency="100" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderHapticTime, Path=Value, StringFormat={}{0:F0}}"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- 震动强度 -->
        <TextBlock Grid.Row="2" Text="震动强度" Margin="0,12,0,2"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="SliderIntensity" Minimum="50" Maximum="255"
                    Value="255" TickFrequency="25" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderIntensity, Path=Value, StringFormat={}{0:F0}}"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- 灯带时间 -->
        <TextBlock Grid.Row="4" Text="灯带显示时间 (ms)" Margin="0,12,0,2"/>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="SliderLightTime" Minimum="500" Maximum="10000"
                    Value="3000" TickFrequency="500" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderLightTime, Path=Value, StringFormat={}{0:F0}}"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- 灯带颜色 -->
        <TextBlock Grid.Row="6" Text="灯带颜色" Margin="0,16,0,6"/>
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="R" FontSize="10" Foreground="#FF6666"/>
                <Slider x:Name="SliderR" Minimum="0" Maximum="255" Value="255"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                <TextBlock Text="G" FontSize="10" Foreground="#66FF66"/>
                <Slider x:Name="SliderG" Minimum="0" Maximum="255" Value="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,4,0">
                <TextBlock Text="B" FontSize="10" Foreground="#6666FF"/>
                <Slider x:Name="SliderB" Minimum="0" Maximum="255" Value="0"/>
            </StackPanel>
            <!-- 颜色预览 -->
            <Border Grid.Column="3" Width="36" Height="36" CornerRadius="6"
                    BorderBrush="#333" BorderThickness="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <Border.Background>
                    <SolidColorBrush>
                        <SolidColorBrush.Color>
                            <MultiBinding Converter="{StaticResource RgbConverter}">
                                <Binding ElementName="SliderR" Path="Value"/>
                                <Binding ElementName="SliderG" Path="Value"/>
                                <Binding ElementName="SliderB" Path="Value"/>
                            </MultiBinding>
                        </SolidColorBrush.Color>
                    </SolidColorBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- 按钮 -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,16,0,0">
            <Button x:Name="BtnTest" Content="测试" Width="72" Height="28" Margin="0,0,8,0"
                    Foreground="#D8D8DD" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#333" CornerRadius="4"
                                BorderBrush="#555" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnSave" Content="保存" Width="72" Height="28"
                    Foreground="#D8D8DD" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#3A5A9A" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
